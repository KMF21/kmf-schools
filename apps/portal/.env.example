# Copy to .env.local for local development. In production, set these in Vercel's project settings.

# The platform domain. Schools without their own domain are served on <slug>.<this domain>.
NEXT_PUBLIC_ROOT_DOMAIN=kmfschools.ng

# Supabase project (Settings → API). Leave both empty to run in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (Settings → API keys → Secret). Server only: creates logins and resets passwords.
# Never commit it and never prefix it with NEXT_PUBLIC_. In Vercel, mark it Sensitive.
SUPABASE_SECRET_KEY=
